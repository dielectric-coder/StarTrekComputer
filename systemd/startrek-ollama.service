[Unit]
Description=Ollama Service for Star Trek Computer
Documentation=https://github.com/jmorganca/ollama
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_ORIGINS=http://localhost:*,http://127.0.0.1:*
Environment=OLLAMA_MODELS=/var/lib/ollama/models
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1

# Performance tuning for Jetson Nano
Environment=OLLAMA_MAX_VRAM=4294967296
Environment=OLLAMA_FLASH_ATTENTION=false
Environment=OLLAMA_USE_MLOCK=false

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ollama /tmp /var/tmp
PrivateTmp=true

# Resource limits for Jetson Nano
MemoryMax=6G
CPUQuota=300%

[Install]
WantedBy=multi-user.target